# Shared hosting: copy this template to backend/.env (beside public/, not inside public/).
# The PHP bootstrap loads that private file automatically; do not commit the real .env.
# DB_USER is the MySQL connection account, not a website users table.
# Admin authentication uses the single configured username/password hash below; no users table is needed.
DB_HOST=127.0.0.1
DB_NAME=ovc_site
DB_USER=ovc_app
DB_PASSWORD=change-me
ADMIN_USERNAME=ovc-admin
# Generate with: php -r 'echo password_hash("a-long-unique-password", PASSWORD_DEFAULT), PHP_EOL;'
ADMIN_PASSWORD_HASH=replace-with-password-hash
CORS_ALLOWED_ORIGINS=https://ovcconstructions.com,https://www.ovcconstructions.com
SESSION_COOKIE_SECURE=true
# Lax works for same-site subdomains. Use None only for truly cross-site hosts; requires HTTPS.
SESSION_SAMESITE=Lax
# Assumes the PHP API is hosted at api.ovcconstructions.com; change if your API uses another host.
PUBLIC_API_URL=https://api.ovcconstructions.com/api
# Optional; default path is backend/storage/media, outside public webroot.
MEDIA_STORAGE_PATH=/absolute/private/path/ovc-media
MAX_UPLOAD_BYTES=104857600
API_BASE_PATH=/api
# Required for the public contact form: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
RATE_LIMIT_HMAC_KEY=replace-with-64-character-random-hex-secret
